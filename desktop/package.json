  "version": "1.0.27",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "node src/dev.mjs",
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "package:dir": "npm run stage && node scripts/package.mjs --dir",
    "package:dir:staged": "node scripts/package.mjs --dir",
    "package": "npm run stage && node scripts/package.mjs",
    "package:store": "node scripts/package.mjs --store",
    "package:store:local": "node scripts/package.mjs --store --local",
    "verify:package": "node scripts/verify-package.mjs",
    "checksums": "node scripts/package-checksums.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "^26.15.3"
  },
