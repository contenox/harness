---
const releaseUrl = 'https://github.com/contenox/harness/releases/latest';
const platforms = [
  { name: 'Linux', detail: '.deb / .rpm' },
  { name: 'Windows', detail: '.exe / .zip' },
  { name: 'macOS', detail: '.dmg / .zip' },
];
---
<div class="download-platforms">
  {platforms.map(({ name, detail }) => (
    <a class="download-platform" href={releaseUrl}>
      <span class="download-platform-heading">{name}</span>
      <span class="download-platform-arch">{detail}</span>
    </a>
  ))}
</div>
<p class="download-note">
  Linux RPM: <code>sudo rpm --import https://contenox.com/contenox-release.asc</code>
  · <a href="https://contenox.com/contenox-release.asc">release key</a>
</p>
