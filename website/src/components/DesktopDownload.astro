---
const repo = 'contenox/harness';
const releaseUrl = `https://github.com/${repo}/releases/latest`;
const keyUrl = 'https://contenox.com/contenox-release.asc';
const fingerprint = '062E 1120 E238 FC6E C749 93D9 5F6B CC9B 4C0C F024';

let release: any = null;
try {
  const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
  if (process.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
  const response = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, { headers });
  if (response.ok) release = await response.json();
} catch {}

const assets: any[] = release?.assets ?? [];
const asset = (suffix: string) => assets.find(item => item.name.endsWith(suffix));
const choices = {
  linux: {
    name: 'Linux',
    href: asset('-linux-amd64.deb')?.browser_download_url ?? releaseUrl,
    hint: 'Debian / Ubuntu · .deb',
    rpm: asset('-linux-x86_64.rpm')?.browser_download_url ?? releaseUrl,
  },
  windows: {
    name: 'Windows',
    href: asset('-win-x64.exe')?.browser_download_url ?? releaseUrl,
    hint: 'Windows 10 / 11 · x64 · .exe',
    zip: asset('-win-x64.zip')?.browser_download_url ?? releaseUrl,
  },
  darwin: {
    name: 'macOS',
    href: asset('-mac-arm64.dmg')?.browser_download_url ?? releaseUrl,
    hint: 'Apple Silicon · .dmg',
    zip: asset('-mac-arm64.zip')?.browser_download_url ?? releaseUrl,
  },
};
const checksums = release ? `https://github.com/${repo}/releases/download/${release.tag_name}/SHA256SUMS` : releaseUrl;
const checksumsSig = release ? `${checksums}.asc` : releaseUrl;
---
<div class="desktop-download" data-download data-release={release?.tag_name ?? ''}>
  <a class="download-primary" data-primary href={releaseUrl}>
    <span data-primary-label>Download Contenox</span>
    <span class="download-primary-hint" data-primary-hint>Choose your platform</span>
  </a>

  <p class="download-other">
    <span>Also for</span>
    <span class="download-group">
      <a data-alt="linux" data-href={choices.linux.href} href={choices.linux.href}>Linux</a>
      <a data-alt="linux-rpm" data-href={choices.linux.rpm} href={choices.linux.rpm}>.rpm</a>
    </span>
    <span class="download-sep">·</span>
    <span class="download-group">
      <a data-alt="windows" data-href={choices.windows.href} href={choices.windows.href}>Windows</a>
      <a data-alt="windows-zip" data-href={choices.windows.zip} href={choices.windows.zip}>.zip</a>
    </span>
    <span class="download-sep">·</span>
    <span class="download-group">
      <a data-alt="darwin" data-href={choices.darwin.href} href={choices.darwin.href}>macOS</a>
      <a data-alt="darwin-zip" data-href={choices.darwin.zip} href={choices.darwin.zip}>.zip</a>
    </span>
  </p>

  <details class="download-verify">
    <summary>Verify this download</summary>
    <p>Signed with the Contenox release key <code>{fingerprint}</code>.</p>
    <p><code>sudo rpm --import {keyUrl}</code></p>
    <p><code>gpg --verify SHA256SUMS.asc SHA256SUMS &amp;&amp; sha256sum -c SHA256SUMS</code></p>
    <p><a href={checksums}>SHA256SUMS</a> · <a href={checksumsSig}>signature</a> · <a href={keyUrl}>release key</a></p>
  </details>
</div>

<style>
  .desktop-download {
    display: grid;
    gap: 0.8rem;
  }
  .download-primary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--signal);
    color: #14130d;
    background: var(--signal);
    font-size: 0.95rem;
    font-weight: 600;
    transition: background-color 160ms ease, transform 160ms ease;
  }
  .download-primary:hover {
    background: var(--signal-bright);
    transform: translateY(-1px);
  }
  .download-primary-hint {
    color: color-mix(in srgb, #14130d 62%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
  }
  .download-other,
  .download-verify {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .download-other {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: baseline;
  }
  .download-group {
    display: inline-flex;
    gap: 0.3rem;
    align-items: baseline;
  }
  .download-sep {
    color: var(--muted);
    padding: 0 0.15rem;
  }
  .download-other a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }
  .download-verify summary {
    cursor: pointer;
    color: var(--ink);
  }
  .download-verify code {
    overflow-wrap: anywhere;
  }
</style>

<script>
  const detected = /mac/i.test(navigator.platform) ? 'darwin'
    : /win/i.test(navigator.platform) ? 'windows' : 'linux';
  const choices: Record<string, { name: string; hint: string }> = {
    linux: { name: 'Linux', hint: 'Debian / Ubuntu · .deb' },
    windows: { name: 'Windows', hint: 'Windows 10 / 11 · x64 · .exe' },
    darwin: { name: 'macOS', hint: 'Apple Silicon · .dmg' },
  };
  document.querySelectorAll<HTMLElement>('[data-download]').forEach(root => {
    const primary = root.querySelector<HTMLAnchorElement>('[data-primary]');
    const label = root.querySelector<HTMLElement>('[data-primary-label]');
    const hint = root.querySelector<HTMLElement>('[data-primary-hint]');
    const choice = choices[detected];
    if (!primary || !label || !hint || !choice) return;
    const href = root.querySelector<HTMLAnchorElement>(`[data-alt="${detected}"]`)?.dataset.href;
    if (href) primary.href = href;
    label.textContent = `Download for ${choice.name}`;
    hint.textContent = choice.hint;
  });
</script>
