---
const indexUrl = 'https://contenox-modeld-artifacts-573643652148.s3.amazonaws.com/releases/desktop/index.json';
const keyUrl = 'https://contenox.com/contenox-release.asc';
---
<div class="desktop-download" data-download data-index={indexUrl}>
  <p class="download-status" data-status>Checking installers…</p>
  <div data-ready hidden>
    <a class="download-primary" data-primary href="#">
      <span data-primary-label>Download Contenox</span>
      <span class="download-primary-hint" data-primary-hint></span>
    </a>
    <p class="download-other" data-other></p>
    <details class="download-verify">
      <summary>Verify this download</summary>
      <p>Every installer is covered by <code>SHA256SUMS</code> and its detached GPG signature.</p>
      <p><code>gpg --import contenox-release.asc</code><br />
        <code>gpg --verify SHA256SUMS.asc SHA256SUMS</code><br />
        <code>sha256sum -c SHA256SUMS</code></p>
      <p>On macOS: <code>shasum -a 256 -c SHA256SUMS</code></p>
      <p data-links></p>
    </details>
  </div>
  <a class="download-primary" data-fallback href="https://github.com/contenox/harness/releases" hidden>Open releases</a>
</div>

<style>
  .desktop-download { display: grid; gap: 0.8rem; }
  .download-status { margin: 0; font: 400 0.8rem/1.5 var(--font-mono); color: var(--muted); }
  .download-primary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 3.5rem; padding: 0.9rem 1.1rem;
    border: 1px solid var(--signal); color: #14130d; background: var(--signal);
    font-size: 0.95rem; font-weight: 600;
    transition: background-color 160ms ease, transform 160ms ease;
  }
  .download-primary:hover { background: var(--signal-bright); transform: translateY(-1px); }
  .download-primary-hint { color: color-mix(in srgb, #14130d 62%, transparent); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 400; }
  .download-other, .download-verify { font-size: 0.78rem; color: var(--muted); }
  .download-other { display: flex; flex-wrap: wrap; gap: 0.55rem 0.9rem; align-items: baseline; }
  .download-other a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 0.25em; }
  .download-other a:hover { text-decoration-thickness: 2px; }
  .download-other a + a { margin-left: 0.6rem; }
  .download-other .download-sep { color: var(--muted); padding: 0 0.15rem; }
  .download-verify summary { cursor: pointer; color: var(--ink); }
  .download-verify code { overflow-wrap: anywhere; }
</style>

<script>
  type Artifact = { name: string; path: string; sha256: string; size: number };
  type Release = { version: string; platform: string; artifacts: Artifact[]; checksums: string; checksumSigned: boolean; signature?: string; signingKey?: string };
  type Index = { schema: number; releases: Release[] };

  const platforms: Record<string, { name: string; primary: string; secondary: string; hint: string }> = {
    'linux-amd64': { name: 'Linux', primary: '.deb', secondary: '.rpm', hint: 'Debian / Ubuntu · .deb' },
    'windows-amd64': { name: 'Windows', primary: '.exe', secondary: '.zip', hint: 'Windows 10 / 11 · x64 · .exe' },
    'macos-arm64': { name: 'macOS', primary: '.dmg', secondary: '.zip', hint: 'Apple Silicon · .dmg' },
  };

  function detect(): string {
    const source = `${navigator.platform} ${navigator.userAgent}`.toLowerCase();
    if (source.includes('mac')) return 'macos-arm64';
    if (source.includes('win')) return 'windows-amd64';
    return 'linux-amd64';
  }

  function versionParts(version: string): (number | string)[] {
    return version.replace(/^v/, '').split(/[.-]/).map(part => /^\d+$/.test(part) ? Number(part) : part);
  }

  function newer(left: string, right: string): boolean {
    const a = versionParts(left), b = versionParts(right);
    for (let i = 0; i < Math.max(a.length, b.length); i += 1) {
      if (a[i] === undefined) return false;
      if (b[i] === undefined) return true;
      if (a[i] === b[i]) continue;
      if (typeof a[i] === typeof b[i]) return (a[i] as number | string) > (b[i] as number | string);
      return typeof a[i] === 'number';
    }
    return false;
  }

  function latestByPlatform(releases: Release[]): Map<string, Release> {
    const latest = new Map<string, Release>();
    for (const release of releases) {
      if (!platforms[release.platform]) continue;
      const current = latest.get(release.platform);
      if (!current || newer(release.version, current.version)) latest.set(release.platform, release);
    }
    return latest;
  }

  function asset(release: Release, suffix: string): Artifact | undefined {
    return release.artifacts.find(artifact => artifact.name.endsWith(suffix));
  }

  document.querySelectorAll<HTMLElement>('[data-download]').forEach(root => {
    const status = root.querySelector<HTMLElement>('[data-status]');
    const ready = root.querySelector<HTMLElement>('[data-ready]');
    const primary = root.querySelector<HTMLAnchorElement>('[data-primary]');
    const label = root.querySelector<HTMLElement>('[data-primary-label]');
    const hint = root.querySelector<HTMLElement>('[data-primary-hint]');
    const other = root.querySelector<HTMLElement>('[data-other]');
    const links = root.querySelector<HTMLElement>('[data-links]');
    const fallback = root.querySelector<HTMLAnchorElement>('[data-fallback]');

    const showError = () => {
      if (status) status.textContent = 'Installers are temporarily unavailable.';
      if (fallback) fallback.hidden = false;
    };

    fetch(root.dataset.index ?? '', { cache: 'no-store' })
      .then(response => response.ok ? response.json() as Promise<Index> : Promise.reject(new Error(String(response.status))))
      .then((index: Index) => {
        if (index.schema !== 1 || !Array.isArray(index.releases)) throw new Error('invalid index');
        const latest = latestByPlatform(index.releases);
        const currentKey = detect();
        const current = latest.get(currentKey) ?? latest.get('linux-amd64') ?? [...latest.values()][0];
        if (!current || !primary || !label || !hint || !other || !links) throw new Error('no release');

        const info = platforms[current.platform];
        const primaryAsset = asset(current, info.primary);
        const secondaryAsset = asset(current, info.secondary);
        if (!primaryAsset) throw new Error('no primary artifact');

        primary.href = primaryAsset.path.replace(/^/, root.dataset.base ? `${root.dataset.base}/` : '');
        // Paths in the index are relative to the index directory.
        const base = (root.dataset.index ?? '').replace(/\/index\.json$/, '');
        primary.href = `${base}/${primaryAsset.path}`;
        label.textContent = `Download for ${info.name}`;
        hint.textContent = info.hint;

        const also: string[] = [];
        for (const [key, release] of latest) {
          if (key === current.platform) continue;
          const platformInfo = platforms[key];
          const artifact = asset(release, platformInfo.primary);
          if (!artifact) continue;
          also.push(`<span class="download-group"><a href="${base}/${artifact.path}">${platformInfo.name}</a><a href="${base}/${artifact.path}">${platformInfo.primary}</a></span>`);
        }
        if (secondaryAsset) {
          also.unshift(`<span class="download-group"><a href="${base}/${secondaryAsset.path}">${info.name}</a><a href="${base}/${secondaryAsset.path}">${info.secondary}</a></span>`);
        }
        other.innerHTML = `<span>Also for</span>${also.join('<span class="download-sep">·</span>')}`;

        const checksum = `${base}/${current.checksums}`;
        links.innerHTML = `<a href="${checksum}">SHA256SUMS</a> · <a href="${base}/${current.signature ?? current.checksums + '.asc'}">signature</a> · <a href="${keyUrl}">release key</a>`;

        if (status) status.hidden = true;
        ready.hidden = false;
      })
      .catch(showError);
  });
</script>
