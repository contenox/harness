---
export interface LandingStrings {
  eyebrow: string;
  h1: string;
  lede: string;
  ctaInstall: string;
  ctaHow: string;
  principles: string[];
  s1Eyebrow: string;
  s1H2: string;
  s1P1: string;
  s1P2: string;
  s2Eyebrow: string;
  s2H2: string;
  s2P: string;
  s2Note: string;
  s3Eyebrow: string;
  s3H2: string;
  s3P: string;
  s3License: string;
  endEyebrow: string;
  endH2: string;
  endCta: string;
}
interface Props {
  t: LandingStrings;
}
const { t } = Astro.props;
const install = 'curl -fsSL https://contenox.com/install.sh | sh';
const foundation = ['Go', 'SQLite', 'PostgreSQL', 'NATS', 'Valkey', 'MCP', 'ACP'];
const eyebrow = 'text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400';
const h2 = 'mt-4 text-3xl font-bold tracking-tight sm:text-4xl';
const body = 'mt-6 max-w-2xl text-base leading-relaxed text-neutral-600 dark:text-neutral-300';
const primary = 'rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200';
const ghost = 'rounded-lg border border-neutral-300 px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-900';
const index = 'text-sm font-medium tabular-nums text-neutral-400 dark:text-neutral-600';
---

<section class="border-b border-neutral-200 px-5 pb-20 pt-24 dark:border-neutral-800">
  <div class="mx-auto max-w-5xl">
    <p class={eyebrow}>{t.eyebrow}</p>
    <h1 class="mt-6 max-w-3xl text-5xl font-bold tracking-tight sm:text-6xl">{t.h1}</h1>
    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">{t.lede}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="#install" class={primary}>{t.ctaInstall}</a>
      <a href="#harness" class={ghost}>{t.ctaHow}</a>
    </div>
    <ul class="mt-16 flex flex-wrap gap-x-8 gap-y-2 border-t border-neutral-200 pt-6 text-sm text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
      {t.principles.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<section id="harness" class="scroll-mt-20 border-b border-neutral-200 px-5 py-20 dark:border-neutral-800">
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[4rem_1fr]">
    <div class={index}>01</div>
    <div>
      <p class={eyebrow}>{t.s1Eyebrow}</p>
      <h2 class={h2}>{t.s1H2}</h2>
      <p class={body}>{t.s1P1}</p>
      <p class={body}>{t.s1P2}</p>
    </div>
  </div>
</section>

<section id="install" class="scroll-mt-20 border-b border-neutral-200 px-5 py-20 dark:border-neutral-800">
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[4rem_1fr]">
    <div class={index}>02</div>
    <div>
      <p class={eyebrow}>{t.s2Eyebrow}</p>
      <h2 class={h2}>{t.s2H2}</h2>
      <p class={body}>{t.s2P}</p>
      <div class="mt-8 flex max-w-xl items-center justify-between gap-4 rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-900">
        <span class="truncate">{install}</span>
      </div>
      <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">{t.s2Note}</p>
    </div>
  </div>
</section>

<section id="foundation" class="scroll-mt-20 border-b border-neutral-200 px-5 py-20 dark:border-neutral-800">
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[4rem_1fr]">
    <div class={index}>03</div>
    <div>
      <p class={eyebrow}>{t.s3Eyebrow}</p>
      <h2 class={h2}>{t.s3H2}</h2>
      <p class={body}>{t.s3P}</p>
      <ul class="mt-10 grid grid-cols-2 gap-x-8 gap-y-4 border-t border-neutral-200 pt-8 sm:grid-cols-4 dark:border-neutral-800">
        {foundation.map((name) => (
          <li class="text-sm font-medium text-neutral-800 dark:text-neutral-200">{name}</li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-neutral-500 dark:text-neutral-400">{t.s3License}</p>
    </div>
  </div>
</section>

<section class="px-5 py-24">
  <div class="mx-auto max-w-5xl">
    <p class={eyebrow}>{t.endEyebrow}</p>
    <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{t.endH2}</h2>
    <a href="#install" class={`mt-10 inline-block ${primary}`}>{t.endCta}</a>
  </div>
</section>
