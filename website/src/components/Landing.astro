---
export interface LandingStrings {
  eyebrow: string;
  h1: string;
  lede: string;
  ctaInstall: string;
  ctaHow: string;
  principles: string[];
  s1Eyebrow: string;
  s1H2: string;
  s1P1: string;
  s1P2: string;
  s2Eyebrow: string;
  s2H2: string;
  s2P: string;
  s2Note: string;
  s3Eyebrow: string;
  s3H2: string;
  s3P: string;
  s3License: string;
  endEyebrow: string;
  endH2: string;
  endCta: string;
}
interface Props {
  t: LandingStrings;
}
import DesktopDownload from './DesktopDownload.astro';
import showcase from '../data/showcase.json';
const { t } = Astro.props;
// Heavy product media lives in the website assets bucket, never in the repo.
const media = 'https://contenox-website-assets-573643652148.s3.amazonaws.com/media/';
const foundation = [
  ['Go', 'the implementation'],
  ['SQLite', 'default state'],
  ['PostgreSQL', 'server state'],
  ['NATS', 'server messaging'],
  ['Valkey', 'server cache'],
  ['MCP', 'tool servers'],
  ['ACP', 'editor protocol'],
];
---

<div class="storefront">
  <section class="hero">
    <div class="hero-aura" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.h1}</h1>
      <p class="hero-lede">{t.lede}</p>
      <div class="hero-actions">
        <a href="#download" class="button button-primary">{t.ctaInstall}</a>
        <a href="#showcase" class="button button-quiet">
          {t.ctaHow} <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div id="showcase" class="product-stage">
      <div class="stage-header" aria-hidden="true">
        <span>Contenox</span>
        <span class="stage-status"><i></i> Workbench</span>
      </div>
      <div class="stage-media">
        {showcase.sources.length > 0 ? (
          <video
            muted
            playsinline
            controls
            preload="metadata"
            poster={showcase.poster}
            aria-label="Contenox workbench demonstration"
          >
            {showcase.sources.map(({ src, type }) => <source src={src} type={type} />)}
          </video>
        ) : (
          <img
            src={showcase.poster}
            alt="The Contenox workbench: workspace tree, live transcript and file preview beside one session."
            decoding="async"
          />
        )}
      </div>
    </div>

    <div class="principles" aria-label="Contenox principles">
      {t.principles.map((p) => <span>{p}</span>)}
    </div>
  </section>

  <section class="editorial-section workbench-section">
    <div class="section-index" aria-hidden="true">01</div>
    <div class="section-heading">
      <p class="eyebrow">{t.s1Eyebrow}</p>
      <h2>{t.s1H2}</h2>
    </div>
    <div class="section-copy">
      <p>{t.s1P1}</p>
      <p>{t.s1P2}</p>
    </div>
  </section>

  <section id="download" class="editorial-section download-section scroll-mt-16">
    <div class="section-index" aria-hidden="true">02</div>
    <div class="section-heading">
      <p class="eyebrow">{t.s2Eyebrow}</p>
      <h2>{t.s2H2}</h2>
    </div>
    <div class="download-intro">
      <p>{t.s2P}</p>
      <p class="download-note">{t.s2Note}</p>
    </div>
    <div class="download-area">
      <div class="download-install">
        <DesktopDownload />
      </div>
    </div>
  </section>

  <section id="built-on" class="foundation-section scroll-mt-16">
    <div class="foundation-heading">
      <p class="eyebrow">{t.s3Eyebrow}</p>
      <h2>{t.s3H2}</h2>
      <p>{t.s3P}</p>
    </div>
    <div class="foundation-list">
      {foundation.map(([name, role]) => (
        <div class="foundation-item">
          <span>{name}</span>
          <small>{role}</small>
        </div>
      ))}
    </div>
    <p class="foundation-license">{t.s3License}</p>
  </section>

  <section class="final-section">
    <div class="final-copy">
      <p class="eyebrow">{t.endEyebrow}</p>
      <h2>{t.endH2}</h2>
      <a href="#download" class="button button-dark">{t.endCta}</a>
    </div>
    <div class="frog-field">
      <span class="frog-caption">Phyllobates terribilis</span>
      <img src={`${media}phyllobates-terribilis-a19746b09422999e0e3774b16281cee67bce7bae33681c563b62f2f2b0f117e3.webp`} alt="Golden poison frog" decoding="async" />
    </div>
  </section>
</div>

<style>
  .stage-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .download-install {
    max-width: 32rem;
  }

  .download-note {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }
</style>
