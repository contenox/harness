---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import type { LandingStrings } from '../components/Landing.astro';

const t: LandingStrings = {
  eyebrow: 'Contenox Harness',
  h1: 'What will you make?',
  lede: 'A harness for demanding work — and the people accountable for it.',
  ctaInstall: 'Install Contenox',
  ctaHow: 'How it works',
  principles: ['Operator-controlled', 'Model-independent', 'Open source'],
  s1Eyebrow: 'The harness',
  s1H2: 'Your machine. Your models. Your policy.',
  s1P1:
    'Contenox runs authored workflows as a local process. The policy that gates each tool call is a file you wrote, enforced before anything runs — not by a hosted service.',
  s1P2:
    'Backends are configuration: any provider key or local endpoint you add. The model named in the request is the model that serves it, or the run stops with the candidates it could have used. Sessions, approvals and per-step records stay on disk.',
  s2Eyebrow: 'Install',
  s2H2: 'Contenox for your machine.',
  s2P:
    'One binary. No account, no service, nothing hosted. Editors attach over ACP; the cockpit is served from the same process.',
  s2Note: 'Then run contenox setup to choose a provider and a model.',
  s3Eyebrow: 'The foundation',
  s3H2: 'Built in the open.',
  s3P:
    'SQLite is the zero-dependency default. PostgreSQL, NATS and Valkey form the server-backed deployment.',
  s3License: 'The Contenox Project is 100% Fair & Open Source under the Apache-2.0 License.',
  endEyebrow: 'Contenox',
  endH2: 'Start with Contenox.',
  endCta: 'Install Contenox',
};
---

<Base
  title="Contenox — What will you make?"
  description="An agent harness for policy-bound, vendor-agnostic AI-assisted software engineering."
  alternates={{ en: '/', de: '/de/' }}
>
  <Landing t={t} />
</Base>
