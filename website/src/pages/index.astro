---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import type { LandingStrings } from '../components/Landing.astro';

const t: LandingStrings = {
  eyebrow: 'Contenox Harness',
  h1: 'What will you make?',
  lede: 'A desktop app for demanding work — and the people accountable for it.',
  ctaInstall: 'Install Contenox',
  ctaHow: 'How it works',
  principles: ['Operator-controlled', 'Model-independent', 'Open source'],
  s1Eyebrow: 'The harness',
  s1H2: 'Your machine. Your models. Your policy.',
  s1P1:
    'Software engineering was never about syntax. AI changed how we build software; our tools didn’t.',
  s1P2:
    'Contenox is an open-source, vendor-neutral desktop app for AI-assisted work. You choose the model and provider. You write the rules, and they are enforced before an agent acts. It starts with software engineering. Sessions, approvals, and run history stay on your machine.',
  s2Eyebrow: 'Install',
  s2H2: 'Contenox for your machine.',
  s2P:
    'An open-source, vendor-neutral workspace for AI-assisted engineering. No subscription. No hosted service.',
  s3Eyebrow: 'The foundation',
  s3H2: 'Built in the open.',
  s3P:
    'Open source, local, and policy-enforced by default. You decide what an agent can read, run, and change before it acts.',
  s3License: 'The Contenox Project is 100% Fair & Open Source under the Apache-2.0 License.',
  endEyebrow: 'Contenox',
  endH2: 'Start with Contenox.',
  endCta: 'Install Contenox',
};
---

<Base
  title="Contenox — What will you make?"
  description="An agent harness for policy-bound, vendor-agnostic AI-assisted software engineering."
  alternates={{ en: '/', de: '/de/' }}
>
  <Landing t={t} />
</Base>
