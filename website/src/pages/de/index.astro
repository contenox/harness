const t: LandingStrings = {
  eyebrow: 'Contenox Harness',
  h1: 'Was wirst du bauen?',
  lede: 'Eine Desktop-App für anspruchsvolle Arbeit — und für die, die dafür geradestehen.',
  ctaInstall: 'Contenox installieren',
  ctaHow: 'So funktioniert es',
  principles: ['Operator-kontrolliert', 'Modellunabhängig', 'Open Source'],
  s1Eyebrow: 'Das Harness',
  s1H2: 'Deine Maschine. Deine Modelle. Deine Policy.',
  s1P1:
    'Softwareentwicklung ging nie um Syntax. KI verändert, wie wir Software bauen; unsere Werkzeuge nicht.',
  s1P2:
    'Contenox ist eine quelloffene, anbieterneutrale Desktop-App für KI-gestützte Arbeit. Du wählst Modell und Anbieter. Du schreibst die Regeln, und sie werden durchgesetzt, bevor ein Agent handelt. Es beginnt mit Softwareentwicklung. Sitzungen, Freigaben und Verlauf bleiben auf deinem Rechner.',
  s2Eyebrow: 'Installation',
  s2H2: 'Contenox für deine Maschine.',
