  s3Eyebrow: 'Das Fundament',
  s3H2: 'Offen gebaut.',
  s3P:
    'Quelloffen, lokal und standardmäßig richtlinienbasiert. Du entscheidest, worauf ein Agent zugreifen, was er ausführen und ändern darf, bevor er handelt.',
  s3License: 'Das Contenox-Projekt ist vollständig Fair & Open Source unter der Apache-2.0-Lizenz.',
  endEyebrow: 'Contenox',
  endH2: 'Mit Contenox starten.',
  endCta: 'Contenox installieren',
};
---

<Base
  title="Contenox — Was wirst du bauen?"
  description="Ein Agent-Harness für policy-gebundene, herstellerunabhängige KI-gestützte Softwareentwicklung."
  lang="de"
  alternates={{ en: '/', de: '/de/' }}
>
  <Landing t={t} />
</Base>
